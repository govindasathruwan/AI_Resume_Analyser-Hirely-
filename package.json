{
  "name": "ai-resume-analyser-desktop",
  "version": "1.0.0",
  "description": "AI Resume Analyser Standalone Desktop Application",
  "main": "electron/main.js",
  "author": "AI Resume Analyser",
  "license": "MIT",
  "scripts": {
    "postinstall": "npm install --prefix frontend && npm install --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "concurrently -k \"npm run dev --prefix frontend\" \"npm run dev --prefix backend\"",
    "dev:desktop": "concurrently -k \"npm run dev --prefix frontend\" \"cross-env DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "pack": "npm run build:frontend && electron-builder --dir",
    "dist:mac": "npm run build:frontend && electron-builder --mac dmg zip",
    "dist:win": "npm run build:frontend && electron-builder --win nsis portable",
    "dist:all": "npm run build:frontend && electron-builder --mac --win"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.1",
    "openai": "^4.52.7",
    "pdf-parse": "^1.1.1",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.airesumeanalyser.desktop",
    "productName": "Hirely",
    "copyright": "Copyright © 2026 Hirely",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hirely"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
